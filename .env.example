# Copy this file to ".env" and fill in your key. .env is gitignored.
# This is the API key for whichever provider is set in config.json.
VYRA_API_KEY=

# Optional overrides (take priority over config.json) — handy for switching providers fast:
# VYRA_PROVIDER=claude        # claude | openrouter | google
# VYRA_MODEL=claude-sonnet-5-5
# VYRA_BASE_URL=              # only needed for custom/OpenAI-compatible endpoints
